<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@color/bg_dark">

    <ImageView
        android:id="@+id/iv_torch"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/ic_torch_off"
        android:contentDescription="Torch Icon"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btn_toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Turn ON Torch"
        android:textSize="22sp"
        android:textStyle="bold"
        android:padding="16dp 32dp"
        style="@style/TorchButton" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tap button to toggle flashlight"
        android:textColor="@color/text_light"
        android:textSize="14sp"
        android:layout_marginTop="24dp" />
</LinearLayout>
