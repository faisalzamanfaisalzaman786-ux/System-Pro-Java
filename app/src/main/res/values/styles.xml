<resources>
    <!-- ==================== شেপ اپیئرنس (کونر گول کرنے کے لیے) ==================== -->
    <style name="ShapeAppearance.Corner">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeAppearance.CornerSmall">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">4dp</item>
    </style>

    <style name="ShapeAppearance.CornerLarge">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- ==================== جنرل بٹن (سب سے زیادہ استعمال) ==================== -->
    <style name="GenericButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="android:backgroundTint">?attr/colorPrimary</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Corner</item>
    </style>

    <!-- سیکنڈری بٹن (آؤٹ لائنڈ) -->
    <style name="GenericButtonOutlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Corner</item>
    </style>

    <!-- ٹیکسٹ بٹن (بغیر بیک گراؤنڈ) -->
    <style name="GenericButtonText" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:padding">8dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <!-- ==================== جنرل ٹیکسٹ ویو ==================== -->
    <style name="GenericTextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <!-- ٹائٹل ٹیکسٹ ویو -->
    <style name="GenericTextView.Title" parent="GenericTextView">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- سب ٹائٹل -->
    <style name="GenericTextView.Subtitle" parent="GenericTextView">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- ==================== ایڈیٹ ٹیکسٹ (انپٹ فیلڈ) ==================== -->
    <style name="GenericEditText" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">?attr/colorPrimary</item>
        <item name="hintTextColor">?attr/colorPrimaryVariant</item>
        <item name="android:textColorHint">?attr/colorOnSurfaceVariant</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- سادہ ایڈیٹ ٹیکسٹ (بغیر لیبل کے) -->
    <style name="GenericEditTextSimple">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:padding">12dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:background">@drawable/edittext_background</item>
    </style>

    <!-- ==================== کارڈ ویو ==================== -->
    <style name="GenericCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">8dp</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="cardElevation">4dp</item>
        <item name="contentPadding">12dp</item>
    </style>

    <!-- ==================== سوئچ (ٹوگل) ==================== -->
    <style name="GenericSwitch" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="thumbTint">?attr/colorPrimary</item>
        <item name="trackTint">?attr/colorPrimaryVariant</item>
    </style>

    <!-- ==================== چیک باکس ==================== -->
    <style name="GenericCheckBox" parent="Widget.MaterialComponents.CompoundButton.CheckBox">
        <item name="buttonTint">?attr/colorPrimary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- ==================== ریڈیو بٹن ==================== -->
    <style name="GenericRadioButton" parent="Widget.MaterialComponents.CompoundButton.RadioButton">
        <item name="buttonTint">?attr/colorPrimary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- ==================== پروگریس بار ==================== -->
    <style name="GenericProgressBar" parent="Widget.MaterialComponents.ProgressBar">
        <item name="indicatorColor">?attr/colorPrimary</item>
    </style>

    <style name="GenericProgressBarHorizontal" parent="Widget.MaterialComponents.ProgressBar.Horizontal">
        <item name="progressTint">?attr/colorPrimary</item>
    </style>

    <!-- ==================== ڈائیلاگ ==================== -->
    <style name="GenericDialog" parent="Theme.MaterialComponents.Dialog.Alert">
        <item name="colorPrimary">?attr/colorPrimary</item>
        <item name="colorOnSurface">?attr/colorOnSurface</item>
        <item name="android:windowBackground">?attr/colorSurface</item>
    </style>

    <!-- ==================== فلوٹنگ ایکشن بٹن (FAB) ==================== -->
    <style name="GenericFAB" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="tint">?attr/colorOnPrimary</item>
    </style>

    <!-- ==================== سنیک بار ==================== -->
    <style name="GenericSnackbar" parent="Widget.MaterialComponents.Snackbar">
        <item name="android:backgroundTint">?attr/colorOnSurface</item>
        <item name="actionTextColor">?attr/colorPrimary</item>
    </style>

    <!-- ==================== ٹول بار ==================== -->
    <style name="GenericToolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">?attr/colorPrimary</item>
        <item name="titleTextColor">?attr/colorOnPrimary</item>
        <item name="subtitleTextColor">?attr/colorOnPrimary</item>
    </style>

    <!-- ==================== سپنر (ڈراپ ڈاؤن) ==================== -->
    <style name="GenericSpinner" parent="Widget.MaterialComponents.Spinner">
        <item name="android:background">@drawable/spinner_background</item>
        <item name="android:popupBackground">?attr/colorSurface</item>
    </style>

    <!-- ==================== بوٹم نیویگیشن ویو ==================== -->
    <style name="GenericBottomNavigation" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemBackground">?attr/colorSurface</item>
        <item name="itemIconTint">?attr/colorOnSurface</item>
        <item name="itemTextColor">?attr/colorOnSurface</item>
    </style>

    <!-- ==================== ٹیب لے آؤٹ ==================== -->
    <style name="GenericTabLayout" parent="Widget.MaterialComponents.TabLayout">
        <item name="tabIndicatorColor">?attr/colorPrimary</item>
        <item name="tabSelectedTextColor">?attr/colorPrimary</item>
        <item name="tabTextColor">?attr/colorOnSurfaceVariant</item>
    </style>
</resources>
