<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1E1E1E"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="System Pro - Control Panel"
        android:textColor="#00FFCC"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tvTotalRecords"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Loaded Text Elements: 0 Indices"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Target Scale: 5,242,880 KB (5 GB Autonomy)"
        android:textColor="#777777"
        android:textSize="12sp"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnAutoConfig"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TRIGGER AUTO-CONFIGURATION"
        android:textColor="#FFFFFF"
        android:backgroundTint="#333333"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnPurgeBadMemory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="PURGE ALL BAD MEMORIES / LOGS"
        android:textColor="#121212"
        android:backgroundTint="#FF5555"
        android:textStyle="bold"/>

</LinearLayout>
