<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@color/background">
    
    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Counter App"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/colorPrimary"
        android:layout_marginBottom="40dp"/>
    
    <!-- Counter Display -->
    <TextView
        android:id="@+id/counterTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:textSize="100sp"
        android:textStyle="bold"
        android:textColor="@color/colorPrimary"
        android:layout_marginBottom="40dp"
        android:background="@drawable/circle_background"
        android:padding="30dp"
        android:minWidth="200dp"
        android:gravity="center"/>
    
    <!-- Buttons Row -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="30dp">
        
        <!-- Decrement Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/decrementButton"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="-"
            android:textSize="40sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            app:backgroundTint="@color/button_negative"
            android:layout_marginEnd="20dp"
            app:cornerRadius="40dp"/>
        
        <!-- Increment Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/incrementButton"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="+"
            android:textSize="40sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            app:backgroundTint="@color/button_positive"
            app:cornerRadius="40dp"/>
        
    </LinearLayout>
    
    <!-- Reset Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/resetButton"
        android:layout_width="200dp"
        android:layout_height="60dp"
        android:text="RESET"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        app:backgroundTint="@color/button_reset"
        app:cornerRadius="30dp"
        android:icon="@android:drawable/ic_menu_close_clear_cancel"
        android:iconGravity="textStart"/>
    
    <!-- Counter Info -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Click + to increase\nClick - to decrease\nClick RESET to zero"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:layout_marginTop="30dp"
        android:lineSpacingExtra="4dp"/>
    
</LinearLayout>